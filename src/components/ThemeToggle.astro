---
---

<button
  id="theme-toggle"
  type="button"
  class="rounded border border-border px-2 py-1 text-xs text-muted transition-colors hover:text-accent"
  aria-label="Toggle color theme"
>
  <span data-theme-light-only>[ light ]</span>
  <span data-theme-dark-only>[ dark ]</span>
</button>

<style>
  [data-theme='light'] [data-theme-dark-only] { display: none; }
  :root:not([data-theme='light']) [data-theme-light-only] { display: none; }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (_) {}
    });
  })();
</script>
