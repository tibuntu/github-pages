---
import Layout from '~/layouts/Layout.astro';
import AsciiBanner from '~/components/AsciiBanner.astro';
import BlinkingCaret from '~/components/BlinkingCaret.astro';
---

<Layout>
  <section class="space-y-8">
    <AsciiBanner />

    <div class="space-y-1">
      <p class="text-sm text-muted">$ whoami</p>
      <h1 class="text-2xl font-medium">
        Timo Hankamer<BlinkingCaret />
      </h1>
      <p class="text-muted">
        cloud platform engineer &middot; oberhausen, germany
      </p>
    </div>

    <div class="space-y-3 text-fg/90">
      <p>
        Hi. I'm a Cloud Platform Engineer who spends most days in Linux, Kubernetes
        and YAML &mdash; building the kind of platforms other engineers actually
        want to use.
      </p>
      <p>
        This is my little corner of the internet. Nothing fancy. Just a
        <code class="text-accent">tibuntu</code> on the web.
      </p>
    </div>

    <div class="space-y-2">
      <p class="text-sm text-muted">$ cat ~/.contacts</p>
      <ul class="space-y-1">
        <li>
          <span class="inline-block w-[10ch] text-muted">github:</span>
          <a href="https://github.com/tibuntu">github.com/tibuntu</a>
        </li>
        <li>
          <span class="inline-block w-[10ch] text-muted">linkedin:</span>
          <a href="https://www.linkedin.com/in/timohankamer/"
            >linkedin.com/in/timohankamer</a
          >
        </li>
      </ul>
    </div>
  </section>
</Layout>
