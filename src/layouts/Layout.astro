---
import '~/styles/global.css';
import ThemeToggle from '~/components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Timo Hankamer',
  description = 'Cloud Platform Engineer from Oberhausen, Germany',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'home' },
  { href: '/projects', label: 'projects' },
  { href: '/about', label: 'about' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-fg">
    <div class="mx-auto flex min-h-screen max-w-3xl flex-col px-5 py-8 sm:px-8 sm:py-12">
      <header class="mb-12 flex items-center justify-between">
        <nav class="flex gap-5 text-sm">
          {
            nav.map((item) => {
              const active = pathname === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    'transition-colors',
                    active ? 'text-accent' : 'text-fg hover:text-accent',
                  ]}
                >
                  {active ? <span class="text-muted">~/</span> : null}
                  {item.label}
                </a>
              );
            })
          }
        </nav>
        <ThemeToggle />
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <footer class="mt-16 border-t border-border pt-6 text-xs text-muted">
        <p>
          <span class="text-accent">$</span> echo &quot;built with <a
            href="https://astro.build">astro</a
          > &middot; deployed on github pages&quot;
        </p>
      </footer>
    </div>
  </body>
</html>
