{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "astro",
        "@astrojs/**",
        "tailwindcss",
        "@tailwindcss/**"
      ],
      "groupName": "astro packages",
      "groupSlug": "astro"
    }
  ],
  "prFooter": ""
}
